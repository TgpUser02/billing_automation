                            }
                            else {
                                if (JsonObj.FYCHECK == "FAIL") {
                                    valid = false;
                                    addToErrorList("You have already applied for Online SD Refund.");
                                }
                                else {
                                    valid = true;
                                }
                            }
                        }
                        else if (JsonObj.FLDSTATUS == "Application Submited" && JsonObj.DOC_UPLOAD_STATUS == "YES")//added on 27.10.2023
                        {
                            valid = false;
                            addToErrorList("You have already applied for Online SD Refund.");
