                                //}
                            else {
                                valid = false;
                                addToErrorList("You have already applied for Online SD Refund.");
                            }
                        }
                    }
                }
            }
       callAjax("POST", "wss?uiActionName=validateSDrefundProcess&IsAjax=true", param1, false, out.resp);

