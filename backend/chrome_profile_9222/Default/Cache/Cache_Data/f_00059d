function onConsumerTypeChange(consumerTypeObj)
{
    var  selectedIndex=consumerTypeObj.selectedIndex;
    var consumerTypeCodeCode=consumerTypeObj.options[selectedIndex].code;
    var consumerTypeValue=document.getElementById("consumerType").value;
    document.getElementById("hdnDdlConsumerType").value=consumerTypeCodeCode;
    if(consumerTypeValue == "1")
    {     
      document.getElementById("CircleRow").style.display='none';
      document.getElementById("BuRow").style.display='table-row';
    }
    else if(consumerTypeValue == "2")
    {      
      document.getElementById("CircleRow").style.display='table-row';
      document.getElementById("BuRow").style.display='none';
    }
    else if(consumerTypeValue == "-1") 
    {      
      document.getElementById("CircleRow").style.display='none';
      document.getElementById("BuRow").style.display='table-row';
    }
}

