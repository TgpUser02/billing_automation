    var BU = document.getElementById("hdnBu").value;
    var valid = true;
    var ConsumerStatus = document.getElementById("hdnConsumerStatus").value;
    //alert(ConsumerStatus);
    if (ConsumerStatus == "0" || ConsumerStatus == "7") {
        valid = true;
    }
    else {
        valid = false;
        addToErrorList("Facility only for Live consumer.");
    }

    var ConsumerType = document.getElementById("hdnSelectedLTHT").value;
    if (ConsumerType == "HT") {
        valid = true;
    }
    else {
        valid = false;
        addToErrorList("Select HT Consumer only");
    }



    var sessionTimeout = false;
    var params;
    var out =
 {
     resp: function validateSession(res) {

         var JsonObj = eval("(" + res + ")");
         if (JsonObj.toString() == "false" || JsonObj.toString() == "error") {
             sessionTimeout = true;
             valid = false;
             addToErrorList(sessionValidationMessage);
         }
         else {
             sessionTimeout = false;
             if (isEmpty(consumerNumber) && isEmpty(BU)) {
                 addToErrorList(eSelectConsumer);
                 valid = false;
             }
         }
     }
 }
    callAjax("POST", "wss?uiActionName=validateSession&IsAjax=true", params, false, out.resp);

    if (valid) {

        document.getElementById("uiActionName").value = "getHTPowerQuality";
        document.forms[0].action = "wss";
        document.forms[0].submit();
        return true;
    }
    else {
        if (sessionTimeout == false) {
            displayErrors();
            return false;
        }
        else {
            displayErrors();
            document.getElementById("uiActionName").value = "getCustAccountLogin";
            document.forms[0].submit();
            return true;
        }
    }
}


