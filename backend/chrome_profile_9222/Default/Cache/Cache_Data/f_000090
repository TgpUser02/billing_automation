        function payNowClick() {
            //debugger;

            var netbill = document.getElementById("totalBillAmountDPC").innerHTML;
            var message = "Payable bill amount is Zero.Do you want to make advance payment?";
            document.getElementById("consumerNumber").value = document.getElementById("lblConsumerNumber").innerHTML;
